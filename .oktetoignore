# Files that the Okteto CLI sends to Remote Execution.

# "okteto deploy" and "okteto destroy" only need the Kubernetes manifest
[deploy]
*
!k8s.yml

[destroy]
*
!k8s.yml

# "okteto test" only needs what "node --test" reads
[test]
*
!package.json
!package-lock.json
!**/*.js
!static
**/node_modules/**
